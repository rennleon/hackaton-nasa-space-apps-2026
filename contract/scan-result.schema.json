{
  "$defs": {
    "Comparison": {
      "description": "Sign comparison with another series (cross-check source or spatial box).",
      "properties": {
        "against": {
          "title": "Against",
          "type": "string"
        },
        "slope_per_decade": {
          "title": "Slope Per Decade",
          "type": "number"
        },
        "same_sign": {
          "title": "Same Sign",
          "type": "boolean"
        },
        "significant": {
          "title": "Significant",
          "type": "boolean"
        },
        "outcome": {
          "anyOf": [
            {
              "enum": [
                "agree",
                "same_direction_one_unsure",
                "disagree",
                "both_unsure",
                "only_one"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome"
        },
        "against_instrument": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Against Instrument"
        },
        "window_start": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window Start"
        },
        "window_end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window End"
        },
        "text": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "against",
        "slope_per_decade",
        "same_sign",
        "significant",
        "outcome",
        "against_instrument",
        "window_start",
        "window_end",
        "text"
      ],
      "title": "Comparison",
      "type": "object"
    },
    "Homogeneity": {
      "description": "\"Is this one kind of place?\" From long-term means only (never a trend), before any trend is computed.\nThe rules are PROJECT HEURISTICS (the concept follows Hosking & Wallis 1993); the literature gives no thresholds.",
      "properties": {
        "kind": {
          "enum": [
            "one_kind",
            "mixed",
            "single_spot"
          ],
          "title": "Kind",
          "type": "string"
        },
        "reasons": {
          "items": {
            "$ref": "#/$defs/HomogeneityReason"
          },
          "title": "Reasons",
          "type": "array"
        },
        "n_cells": {
          "title": "N Cells",
          "type": "integer"
        },
        "precip_min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Precip Min"
        },
        "precip_max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Precip Max"
        },
        "t2m_min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "T2M Min"
        },
        "t2m_max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "T2M Max"
        },
        "elev_min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elev Min"
        },
        "elev_max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elev Max"
        },
        "climate_groups": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Climate Groups",
          "type": "object"
        },
        "suggestions": {
          "items": {
            "$ref": "#/$defs/HomogeneitySuggestion"
          },
          "title": "Suggestions",
          "type": "array"
        },
        "text": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "kind",
        "reasons",
        "n_cells",
        "precip_min",
        "precip_max",
        "t2m_min",
        "t2m_max",
        "elev_min",
        "elev_max",
        "climate_groups",
        "suggestions",
        "text"
      ],
      "title": "Homogeneity",
      "type": "object"
    },
    "HomogeneityReason": {
      "properties": {
        "code": {
          "enum": [
            "climate_groups",
            "elevation",
            "rain",
            "temperature"
          ],
          "title": "Code",
          "type": "string"
        },
        "text": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "code",
        "text"
      ],
      "title": "HomogeneityReason",
      "type": "object"
    },
    "HomogeneitySuggestion": {
      "description": "A smaller box inside a mixed one that is itself one kind of place.",
      "properties": {
        "bbox": {
          "items": {
            "type": "number"
          },
          "title": "Bbox",
          "type": "array"
        },
        "name": {
          "$ref": "#/$defs/Text"
        },
        "n_cells": {
          "title": "N Cells",
          "type": "integer"
        }
      },
      "required": [
        "bbox",
        "name",
        "n_cells"
      ],
      "title": "HomogeneitySuggestion",
      "type": "object"
    },
    "PlaceProfile": {
      "description": "What kind of place this is, from facts known before any trend (long-term means, elevation, maps).",
      "properties": {
        "ar6_region_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ar6 Region Code"
        },
        "ar6_region_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ar6 Region Name"
        },
        "climate_group": {
          "anyOf": [
            {
              "enum": [
                "tropical",
                "dry",
                "temperate",
                "cold",
                "polar"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Climate Group"
        },
        "climate_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Climate Code"
        },
        "high_up": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "High Up"
        },
        "elevation_m_model": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elevation M Model"
        },
        "wet_months": {
          "items": {
            "type": "integer"
          },
          "title": "Wet Months",
          "type": "array"
        },
        "dry_months": {
          "items": {
            "type": "integer"
          },
          "title": "Dry Months",
          "type": "array"
        },
        "text": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "homogeneity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Homogeneity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "ar6_region_code",
        "ar6_region_name",
        "climate_group",
        "climate_code",
        "high_up",
        "elevation_m_model",
        "wet_months",
        "dry_months",
        "text",
        "homogeneity"
      ],
      "title": "PlaceProfile",
      "type": "object"
    },
    "RegionRef": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "RegionRef",
      "type": "object"
    },
    "ScanEntry": {
      "properties": {
        "variable_id": {
          "title": "Variable Id",
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/Text"
        },
        "role": {
          "enum": [
            "target",
            "driver",
            "response",
            "cross_check"
          ],
          "title": "Role",
          "type": "string"
        },
        "source_type": {
          "enum": [
            "observed",
            "model"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "shortlist_label": {
          "enum": [
            "changing",
            "possibly_changing",
            "no_detectable_change",
            "cant_tell"
          ],
          "title": "Shortlist Label",
          "type": "string"
        },
        "verdict_label": {
          "enum": [
            "significant",
            "significant_fragile",
            "borderline",
            "possibly_changing",
            "no_detectable_change",
            "cant_tell"
          ],
          "title": "Verdict Label",
          "type": "string"
        },
        "slope_per_decade": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Slope Per Decade"
        },
        "units": {
          "$ref": "#/$defs/UnitsInfo"
        },
        "p_decisive": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "P Decisive"
        },
        "p_adjusted": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "P Adjusted"
        },
        "worth_investigating": {
          "title": "Worth Investigating",
          "type": "boolean"
        },
        "mdt_per_decade": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mdt Per Decade"
        },
        "why": {
          "$ref": "#/$defs/Text"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "availability": {
          "default": "available",
          "enum": [
            "available",
            "no_data_here",
            "too_short",
            "too_many_gaps",
            "fetch_failed",
            "box_too_large"
          ],
          "title": "Availability",
          "type": "string"
        },
        "instrument_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instrument Id"
        },
        "yearly_series": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/YearPoint"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Yearly Series"
        },
        "cross_check": {
          "anyOf": [
            {
              "$ref": "#/$defs/Comparison"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "variable_id",
        "name",
        "role",
        "source_type",
        "shortlist_label",
        "verdict_label",
        "slope_per_decade",
        "units",
        "p_decisive",
        "p_adjusted",
        "worth_investigating",
        "mdt_per_decade",
        "why",
        "reason",
        "availability",
        "instrument_id",
        "yearly_series",
        "cross_check"
      ],
      "title": "ScanEntry",
      "type": "object"
    },
    "Text": {
      "additionalProperties": false,
      "description": "One sentence in both registers. `*_es` are the Spanish versions; the front end falls back to English\nwhen they are missing, so they stay optional in the schema (existing consumers keep compiling).",
      "properties": {
        "simple": {
          "title": "Simple",
          "type": "string"
        },
        "scientific": {
          "title": "Scientific",
          "type": "string"
        },
        "simple_es": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Simple Es"
        },
        "scientific_es": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scientific Es"
        }
      },
      "required": [
        "simple",
        "scientific"
      ],
      "title": "Text",
      "type": "object"
    },
    "UnitsInfo": {
      "properties": {
        "display": {
          "title": "Display",
          "type": "string"
        },
        "simple": {
          "title": "Simple",
          "type": "string"
        },
        "decimals": {
          "title": "Decimals",
          "type": "integer"
        }
      },
      "required": [
        "display",
        "simple",
        "decimals"
      ],
      "title": "UnitsInfo",
      "type": "object"
    },
    "YearPoint": {
      "properties": {
        "year": {
          "title": "Year",
          "type": "integer"
        },
        "anomaly": {
          "title": "Anomaly",
          "type": "number"
        },
        "in_window": {
          "default": true,
          "title": "In Window",
          "type": "boolean"
        }
      },
      "required": [
        "year",
        "anomaly",
        "in_window"
      ],
      "title": "YearPoint",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "engine_version": {
      "title": "Engine Version",
      "type": "string"
    },
    "region": {
      "$ref": "#/$defs/RegionRef"
    },
    "theme_id": {
      "title": "Theme Id",
      "type": "string"
    },
    "alpha": {
      "title": "Alpha",
      "type": "number"
    },
    "method": {
      "const": "benjamini_hochberg",
      "default": "benjamini_hochberg",
      "title": "Method",
      "type": "string"
    },
    "window_start": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Window Start"
    },
    "window_end": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Window End"
    },
    "common_window": {
      "title": "Common Window",
      "type": "boolean"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/ScanEntry"
      },
      "title": "Entries",
      "type": "array"
    },
    "place": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlaceProfile"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "schema_version",
    "engine_version",
    "region",
    "theme_id",
    "alpha",
    "method",
    "window_start",
    "window_end",
    "common_window",
    "entries",
    "place"
  ],
  "title": "ScanResult",
  "type": "object"
}
