{
  "$defs": {
    "Chip": {
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning"
          ],
          "title": "Severity",
          "type": "string"
        },
        "text": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "code",
        "severity",
        "text"
      ],
      "title": "Chip",
      "type": "object"
    },
    "Comparison": {
      "description": "Sign comparison with another series (cross-check source or spatial box).",
      "properties": {
        "against": {
          "title": "Against",
          "type": "string"
        },
        "slope_per_decade": {
          "title": "Slope Per Decade",
          "type": "number"
        },
        "same_sign": {
          "title": "Same Sign",
          "type": "boolean"
        },
        "significant": {
          "title": "Significant",
          "type": "boolean"
        },
        "outcome": {
          "anyOf": [
            {
              "enum": [
                "agree",
                "same_direction_one_unsure",
                "disagree",
                "both_unsure",
                "only_one"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome"
        },
        "against_instrument": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Against Instrument"
        },
        "window_start": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window Start"
        },
        "window_end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window End"
        },
        "text": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "against",
        "slope_per_decade",
        "same_sign",
        "significant",
        "outcome",
        "against_instrument",
        "window_start",
        "window_end",
        "text"
      ],
      "title": "Comparison",
      "type": "object"
    },
    "Detectability": {
      "properties": {
        "years_needed": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Years Needed"
        },
        "years_available": {
          "title": "Years Available",
          "type": "number"
        }
      },
      "required": [
        "years_needed",
        "years_available"
      ],
      "title": "Detectability",
      "type": "object"
    },
    "FitPoint": {
      "description": "Trend line on the anomaly scale; low/high are the lines with the 95%\nslope bounds pivoting on the data centre (draw them as a band).",
      "properties": {
        "t": {
          "title": "T",
          "type": "string"
        },
        "trend": {
          "title": "Trend",
          "type": "number"
        },
        "low": {
          "title": "Low",
          "type": "number"
        },
        "high": {
          "title": "High",
          "type": "number"
        }
      },
      "required": [
        "t",
        "trend",
        "low",
        "high"
      ],
      "title": "FitPoint",
      "type": "object"
    },
    "GateCheck": {
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "detail": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "code",
        "passed",
        "detail"
      ],
      "title": "GateCheck",
      "type": "object"
    },
    "Gates": {
      "properties": {
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/GateCheck"
          },
          "title": "Checks",
          "type": "array"
        }
      },
      "required": [
        "passed",
        "checks"
      ],
      "title": "Gates",
      "type": "object"
    },
    "LeaveOneYearOut": {
      "properties": {
        "slope_min": {
          "title": "Slope Min",
          "type": "number"
        },
        "slope_max": {
          "title": "Slope Max",
          "type": "number"
        },
        "worst_p": {
          "title": "Worst P",
          "type": "number"
        },
        "flip_years": {
          "items": {
            "type": "integer"
          },
          "title": "Flip Years",
          "type": "array"
        }
      },
      "required": [
        "slope_min",
        "slope_max",
        "worst_p",
        "flip_years"
      ],
      "title": "LeaveOneYearOut",
      "type": "object"
    },
    "MonthPoint": {
      "properties": {
        "t": {
          "title": "T",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "anomaly": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Anomaly"
        },
        "in_window": {
          "title": "In Window",
          "type": "boolean"
        }
      },
      "required": [
        "t",
        "value",
        "anomaly",
        "in_window"
      ],
      "title": "MonthPoint",
      "type": "object"
    },
    "Persistence": {
      "properties": {
        "r1": {
          "title": "R1",
          "type": "number"
        },
        "n": {
          "title": "N",
          "type": "integer"
        },
        "n_eff": {
          "title": "N Eff",
          "type": "number"
        }
      },
      "required": [
        "r1",
        "n",
        "n_eff"
      ],
      "title": "Persistence",
      "type": "object"
    },
    "Provenance": {
      "description": "Where the series came from. Live sources fill the same fields.",
      "properties": {
        "source_kind": {
          "title": "Source Kind",
          "type": "string"
        },
        "source_ref": {
          "title": "Source Ref",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "requested_bbox": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requested Bbox"
        },
        "data_bbox": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Bbox"
        },
        "n_cells": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N Cells"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved At"
        }
      },
      "required": [
        "source_kind",
        "source_ref",
        "title",
        "requested_bbox",
        "data_bbox",
        "n_cells",
        "retrieved_at"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "PublishedFinding": {
      "description": "A checked statement from published science (e.g. IPCC AR6 regional assessment) for this place.",
      "properties": {
        "statement": {
          "$ref": "#/$defs/Text"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "confidence_es": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence Es"
        },
        "direction": {
          "anyOf": [
            {
              "enum": [
                "up",
                "down",
                "either"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Direction"
        },
        "agreement": {
          "anyOf": [
            {
              "enum": [
                "agrees",
                "differs",
                "too_soon"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agreement"
        },
        "ar6_region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ar6 Region"
        },
        "scope": {
          "default": "mean",
          "enum": [
            "mean",
            "extremes"
          ],
          "title": "Scope",
          "type": "string"
        },
        "partial": {
          "default": false,
          "title": "Partial",
          "type": "boolean"
        }
      },
      "required": [
        "statement",
        "source",
        "confidence",
        "confidence_es",
        "direction",
        "agreement",
        "ar6_region",
        "scope",
        "partial"
      ],
      "title": "PublishedFinding",
      "type": "object"
    },
    "RegionRef": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "RegionRef",
      "type": "object"
    },
    "Robustness": {
      "properties": {
        "leave_one_year_out": {
          "anyOf": [
            {
              "$ref": "#/$defs/LeaveOneYearOut"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "drift_label_with_late_years": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Drift Label With Late Years"
        },
        "cross_check": {
          "anyOf": [
            {
              "$ref": "#/$defs/Comparison"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "spatial": {
          "anyOf": [
            {
              "$ref": "#/$defs/Comparison"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "leave_one_year_out",
        "drift_label_with_late_years",
        "cross_check",
        "spatial"
      ],
      "title": "Robustness",
      "type": "object"
    },
    "Season": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/Text"
        },
        "months": {
          "items": {
            "type": "integer"
          },
          "title": "Months",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "months"
      ],
      "title": "Season",
      "type": "object"
    },
    "Selection": {
      "properties": {
        "worth_investigating": {
          "title": "Worth Investigating",
          "type": "boolean"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/SelectionCheck"
          },
          "title": "Checks",
          "type": "array"
        },
        "mdt_per_decade": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mdt Per Decade"
        },
        "expected_per_decade": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expected Per Decade"
        }
      },
      "required": [
        "worth_investigating",
        "checks",
        "mdt_per_decade",
        "expected_per_decade"
      ],
      "title": "Selection",
      "type": "object"
    },
    "SelectionCheck": {
      "description": "Stage 1 (before any trend): is this variable worth investigating here?",
      "properties": {
        "code": {
          "enum": [
            "question",
            "expectation",
            "fitness",
            "known_breaks",
            "detectability"
          ],
          "title": "Code",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "caution",
            "fail"
          ],
          "title": "Status",
          "type": "string"
        },
        "detail": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "code",
        "status",
        "detail"
      ],
      "title": "SelectionCheck",
      "type": "object"
    },
    "SignificanceTest": {
      "properties": {
        "name": {
          "enum": [
            "mk_hamed_rao",
            "ols_neff",
            "seasonal_mk"
          ],
          "title": "Name",
          "type": "string"
        },
        "p": {
          "title": "P",
          "type": "number"
        },
        "statistic": {
          "title": "Statistic",
          "type": "number"
        },
        "decisive": {
          "title": "Decisive",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "p",
        "statistic",
        "decisive"
      ],
      "title": "SignificanceTest",
      "type": "object"
    },
    "StartYearPoint": {
      "description": "The same trend machinery re-run with the window starting in January of `start`'s year.",
      "properties": {
        "start": {
          "title": "Start",
          "type": "string"
        },
        "years": {
          "title": "Years",
          "type": "number"
        },
        "slope_per_decade": {
          "title": "Slope Per Decade",
          "type": "number"
        },
        "ci_low": {
          "title": "Ci Low",
          "type": "number"
        },
        "ci_high": {
          "title": "Ci High",
          "type": "number"
        },
        "significant": {
          "title": "Significant",
          "type": "boolean"
        }
      },
      "required": [
        "start",
        "years",
        "slope_per_decade",
        "ci_low",
        "ci_high",
        "significant"
      ],
      "title": "StartYearPoint",
      "type": "object"
    },
    "StartYearSensitivity": {
      "description": "Does the answer hold if the window starts in a different year? Context only: the headline\nverdict stays on the declared window (Liebmann et al. 2010, doi:10.1175/2010BAMS3030.1).",
      "properties": {
        "points": {
          "items": {
            "$ref": "#/$defs/StartYearPoint"
          },
          "title": "Points",
          "type": "array"
        },
        "n_starts": {
          "title": "N Starts",
          "type": "integer"
        },
        "n_same_sign": {
          "title": "N Same Sign",
          "type": "integer"
        },
        "n_significant": {
          "title": "N Significant",
          "type": "integer"
        },
        "classification": {
          "enum": [
            "holds",
            "mostly",
            "depends"
          ],
          "title": "Classification",
          "type": "string"
        }
      },
      "required": [
        "points",
        "n_starts",
        "n_same_sign",
        "n_significant",
        "classification"
      ],
      "title": "StartYearSensitivity",
      "type": "object"
    },
    "Text": {
      "additionalProperties": false,
      "description": "One sentence in both registers. `*_es` are the Spanish versions; the front end falls back to English\nwhen they are missing, so they stay optional in the schema (existing consumers keep compiling).",
      "properties": {
        "simple": {
          "title": "Simple",
          "type": "string"
        },
        "scientific": {
          "title": "Scientific",
          "type": "string"
        },
        "simple_es": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Simple Es"
        },
        "scientific_es": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scientific Es"
        }
      },
      "required": [
        "simple",
        "scientific"
      ],
      "title": "Text",
      "type": "object"
    },
    "ThenNow": {
      "description": "Fitted level at the first and last year of the window, in display units\n(simple view shows whole numbers: value * kid_scale).",
      "properties": {
        "year_then": {
          "title": "Year Then",
          "type": "integer"
        },
        "value_then": {
          "title": "Value Then",
          "type": "number"
        },
        "year_now": {
          "title": "Year Now",
          "type": "integer"
        },
        "value_now": {
          "title": "Value Now",
          "type": "number"
        },
        "kid_scale": {
          "title": "Kid Scale",
          "type": "number"
        },
        "kid_label": {
          "title": "Kid Label",
          "type": "string"
        },
        "kid_label_es": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kid Label Es"
        }
      },
      "required": [
        "year_then",
        "value_then",
        "year_now",
        "value_now",
        "kid_scale",
        "kid_label",
        "kid_label_es"
      ],
      "title": "ThenNow",
      "type": "object"
    },
    "Trend": {
      "properties": {
        "slope_per_decade": {
          "title": "Slope Per Decade",
          "type": "number"
        },
        "ci_low": {
          "title": "Ci Low",
          "type": "number"
        },
        "ci_high": {
          "title": "Ci High",
          "type": "number"
        },
        "fit": {
          "items": {
            "$ref": "#/$defs/FitPoint"
          },
          "title": "Fit",
          "type": "array"
        }
      },
      "required": [
        "slope_per_decade",
        "ci_low",
        "ci_high",
        "fit"
      ],
      "title": "Trend",
      "type": "object"
    },
    "UnitsInfo": {
      "properties": {
        "display": {
          "title": "Display",
          "type": "string"
        },
        "simple": {
          "title": "Simple",
          "type": "string"
        },
        "decimals": {
          "title": "Decimals",
          "type": "integer"
        }
      },
      "required": [
        "display",
        "simple",
        "decimals"
      ],
      "title": "UnitsInfo",
      "type": "object"
    },
    "VariableRef": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "giovanni_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Giovanni Id"
        },
        "name": {
          "$ref": "#/$defs/Text"
        },
        "definition": {
          "$ref": "#/$defs/Text"
        },
        "source_type": {
          "enum": [
            "observed",
            "model"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "instrument": {
          "title": "Instrument",
          "type": "string"
        },
        "units": {
          "$ref": "#/$defs/UnitsInfo"
        },
        "instrument_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instrument Id"
        },
        "platform": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Platform"
        },
        "delivered_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delivered By"
        },
        "cell_deg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cell Deg"
        }
      },
      "required": [
        "id",
        "giovanni_id",
        "name",
        "definition",
        "source_type",
        "instrument",
        "units",
        "instrument_id",
        "platform",
        "delivered_by",
        "cell_deg"
      ],
      "title": "VariableRef",
      "type": "object"
    },
    "Verdict": {
      "properties": {
        "label": {
          "enum": [
            "significant",
            "significant_fragile",
            "borderline",
            "possibly_changing",
            "no_detectable_change",
            "cant_tell"
          ],
          "title": "Label",
          "type": "string"
        },
        "certainty": {
          "enum": [
            "sure",
            "maybe",
            "too_soon",
            "cant_tell"
          ],
          "title": "Certainty",
          "type": "string"
        },
        "answer": {
          "$ref": "#/$defs/Text"
        },
        "how_much": {
          "$ref": "#/$defs/Text"
        },
        "headline": {
          "$ref": "#/$defs/Text"
        },
        "sentence": {
          "$ref": "#/$defs/Text"
        },
        "notes": {
          "items": {
            "$ref": "#/$defs/Text"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "label",
        "certainty",
        "answer",
        "how_much",
        "headline",
        "sentence",
        "notes"
      ],
      "title": "Verdict",
      "type": "object"
