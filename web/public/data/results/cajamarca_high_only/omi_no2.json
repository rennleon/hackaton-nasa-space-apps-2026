ue":-0.1664,"anomaly":-0.3383,"in_window":true},{"t":"2024-11","value":null,"anomaly":null,"in_window":true},{"t":"2024-12","value":null,"anomaly":null,"in_window":true},{"t":"2025-01","value":null,"anomaly":null,"in_window":true},{"t":"2025-02","value":null,"anomaly":null,"in_window":true},{"t":"2025-03","value":null,"anomaly":null,"in_window":true},{"t":"2025-04","value":null,"anomaly":null,"in_window":true},{"t":"2025-05","value":-0.199,"anomaly":-0.3026,"in_window":true},{"t":"2025-06","value":0.2078,"anomaly":-0.0445,"in_window":true},{"t":"2025-07","value":-0.0682,"anomaly":-0.2728,"in_window":true},{"t":"2025-08","value":0.1089,"anomaly":-0.2154,"in_window":true},{"t":"2025-09","value":null,"anomaly":null,"in_window":true},{"t":"2025-10","value":null,"anomaly":null,"in_window":true},{"t":"2025-11","value":null,"anomaly":null,"in_window":true},{"t":"2025-12","value":0.1044,"anomaly":-0.159,"in_window":true}],"season_series":null,"yearly_series":[],"then_now":null,"seasonal_share":0.186,"trend":null,"tests":[],"persistence":null,"detectability":null,"robustness":{"leave_one_year_out":null,"drift_label_with_late_years":null,"cross_check":null,"spatial":null,"cell_agreement":null},"chips":[{"code":"known_artifact_row_anomaly_2007-06","severity":"warning","text":{"simple":"Since 2007, part of this satellite's view has been blocked. So some days have no data for your place.","scientific":"OMI row anomaly: a physical obstruction in the sensor view first appeared on 25 June 2007 (cross-track positions 53 and 54) and spread from 11 May 2008; about half of the 60 viewing positions are now affected and affected pixels are flagged. OMI still samples a place about every other day, so the authors expect no loss of statistical weight in averages, but retrievals that use only part of the swath can behave differently, and the aerosol record needed algorithm fixes. We keep the data and count valid days per month (min_valid_days). Sources: Torres, O. et al. 2018, Atmos. Meas. Tech. 11, 2701-2715, doi:10.5194/amt-11-2701-2018, Sections 1-2; OMI Algorithm Team, OMNO2 README (v4.0), Sections 2.1 and 2.4 (it describes version 4.0; Giovanni serves version 003, whose handling was not checked).","simple_es":"Desde 2007, una parte de la vista de este satélite está tapada. Por eso algunos días no hay datos de tu lugar.","scientific_es":"Anomalía de filas de OMI: una obstrucción física en la vista del sensor apareció el 25 de junio de 2007 (posiciones transversales 53 y 54) y se extendió desde el 11 de mayo de 2008; hoy afecta a cerca de la mitad de las 60 posiciones de observación y los píxeles afectados quedan marcados. OMI aún muestrea un lugar casi cada dos días, así que los autores no esperan perder peso estadístico en los promedios, pero las recuperaciones que usan solo parte de la franja pueden comportarse distinto, y el registro de aerosoles necesitó correcciones del algoritmo. Conservamos los datos y contamos los días válidos por mes (min_valid_days). Fuentes: Torres, O. et al. 2018, Atmos. Meas. Tech. 11, 2701-2715, doi:10.5194/amt-11-2701-2018, Secciones 1-2; OMI Algorithm Team, README de OMNO2 (v4.0), Secciones 2.1 y 2.4 (describe la versión 4.0; Giovanni sirve la versión 003, cuyo tratamiento no se comprobó)."}}],"start_years":null,"published":null,"published_context":[],"verdict":{"label":"cant_tell","certainty":"cant_tell","answer":{"simple":"We can't answer this for Cajamarca (only the high mountains) yet.","scientific":"Tropospheric NO₂ column, cloud-screened (OMI OMNO2d), Northern Peruvian Andes, high-elevation core of the Cajamarca box (highland-only twin): not assessable.","simple_es":"Aún no podemos responder esto para Cajamarca (solo las montañas altas).","scientific_es":"Columna de NO₂ troposférico, con filtro de nubes (OMI OMNO2d), Andes del norte del Perú, núcleo de gran altura de la caja de Cajamarca (gemela solo de altura): no evaluable."},"how_much":{"simple":"36 of every 100 months have data (we need 90).","scientific":"Completeness 35.7% within the window (minimum 90%).","simple_es":"36 de cada 100 meses tienen datos (necesitamos 90).","scientific_es":"Completitud de 35.7% en la ventana (mínimo 90%)."},"headline":{"simple":"We can't tell here","scientific":"Not assessable","simple_es":"No podemos saberlo aquí","scientific_es":"No evaluable"},"sentence":{"simple":"36 of every 100 months have data (we need 90).","scientific":"Failed gates. Completeness 35.7% within the window (minimum 90%).","simple_es":"36 de cada 100 meses tienen datos (necesitamos 90).","scientific_es":"Comprobaciones no superadas. Completitud de 35.7% en la ventana (mínimo 90%)."},"notes":[]}}
